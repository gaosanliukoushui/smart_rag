# SmartRAG Production Environment Variables
# Copy this file to .env in the project root and fill in the values

# ── REQUIRED ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-secure-256-bit-secret-here

# ── LLM Provider (at least one required) ─────────────────────────────
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=

# ── Optional CORS overrides (comma-separated origins) ─────────────────
# Leave empty to use defaults: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=
